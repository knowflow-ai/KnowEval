# ===============================================
# KnowEval 环境变量
# ===============================================
# ./start.sh 第一次运行时会复制成 .env；填好后再 ./start.sh 一次生效（docker compose 把它传进容器）。
# .env 已在 .gitignore 里，不要提交。结果文件只记录变量名，不记录值。

# -----------------
# 被测系统的 API Key
# -----------------
# 变量名要和评测台「系统」页、或系统配置 YAML 里 api_key_env 填的一致；下面是默认名字。
# 一个系统接多个应用、每个应用一把 Key（如 Dify）时，再加几个变量，在配置里分别指定。

# KnowFlow：在 KnowFlow 的「API」页生成
KNOWFLOW_API_KEY=
# RAGFlow
RAGFLOW_API_KEY=
# 自研 RAG（通用 HTTP 接口模板）
MY_RAG_API_KEY=

# -----------------
# KnowEval 自己用的模型（判分、出题、自动校验共用一个）
# -----------------
# 接口地址和模型名在评测台「设置」页填（存在工作区的 settings.json，命令行也读它），这里只放 Key。
# 变量名可在「设置」页改。
KNOWEVAL_LLM_API_KEY=
